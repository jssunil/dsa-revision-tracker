# Copy to .env (git-ignored) and fill in the keys you have. Providers without a key are skipped.
# Or reuse an existing file instead of copying keys:  set DSA_ENV_FILE=C:\path\to\other\.env
#
# Tried in this order for pattern checks (server/routing.yaml, tier "verify"):
#   gemini -> groq -> cerebras -> openrouter -> anthropic -> ollama

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPEN_ROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults in server/routing.yaml)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama3.1-8b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ANTHROPIC_MODEL=claude-opus-5

# Local Ollama (last fallback). Set DSA_USE_OLLAMA=0 if you don't run it.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma:latest
# DSA_USE_OLLAMA=1

# Server
# DSA_PORT=8765
# SSL_CERT_FILE=C:\path\to\corporate-ca.pem
